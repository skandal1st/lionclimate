PORT=3001
JWT_SECRET=replace_with_long_random_string
# SQLite database file (absolute or relative to server working directory)
DATABASE_PATH=./data/lionclimate.db

# Admin login: set bcrypt hash (recommended). Generate: node -e "import('bcrypt').then(b=>b.default.hash('your_password',10).then(console.log))"
ADMIN_PASSWORD_HASH=$2b$10$replace_with_bcrypt_hash
# Or for local dev only (plain text compared in constant-time if hash not set):
# ADMIN_PASSWORD=lionclimate2026

# Telegram (optional — leads are always saved to DB)
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs
TELEGRAM_CHAT_IDS=

# Paths relative to project root (lionclimate/), or absolute
PRODUCTS_FILE=data/products.json
UPLOAD_DIR=img/products/
UPLOAD_URL=img/products/

# CORS: comma-separated origins, or * for any
CORS_ORIGIN=*
